rules_version = '2';

// Data model
//   users/{uid}                        -> { email, workspaceId, updatedAt }
//   workspaces/{code}                  -> { members: [uid, ...], createdAt, createdBy }
//   workspaces/{code}/kv/{key}         -> { value: <JSON string>, updatedAt }
//
// A "workspace" is the shared space a household signs into together via an
// invite code (see js/cloud-store.js). Every profile, tracker log and the
// shared Guru's Teachings library are stored as kv documents under the
// caller's workspace, so anyone who is a member can read and write them —
// that's what makes data shared across the household's devices.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /workspaces/{workspaceId} {
      // Looking up a single workspace by its exact invite code is required
      // to join one; enumerating all workspaces is never allowed.
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.members == [request.auth.uid];

      allow update: if request.auth != null && (
                      request.auth.uid in resource.data.members ||
                      request.resource.data.members == resource.data.members.concat([request.auth.uid])
                    );

      allow delete: if false;

      match /kv/{key} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
      }
    }
  }
}
